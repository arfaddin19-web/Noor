{
  "expo": {
    "name": "Noor",
    "slug": "noor",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.noor.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Noor uses your location to show prayer times, Qibla direction, and nearby masjids/halal food for where you are."
      }
    },
    "android": {
      "package": "com.noor.app",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0e8a72"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0f2226"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/splash-icon.png",
          "color": "#0e8a72"
        }
      ]
    ],
    "extra": {
      "supabaseUrl": "https://njivttoglciffuwqjefd.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5qaXZ0dG9nbGNpZmZ1d3FqZWZkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODc1ODkwNzMsImV4cCI6MjEwMzE2NTA3M30.E89P3l1BP06yGqB5-wWfRJzSU847IWb6xC3JGxE1N7U"
    }
  }
}
